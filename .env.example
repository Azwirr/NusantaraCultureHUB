# Copy to .env.local for local development. Never commit .env.local.
#
# Public by design (safe in the browser; every request is still filtered by
# RLS). `npx supabase status` prints the local values after `npx supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only. Used to build links in sign-up emails, so a forged Host header
# cannot change them. Set it to the deployed origin on Vercel.
SITE_URL=http://localhost:3000

# Signed-in E2E tests (tests/e2e/signed-in.spec.ts). Staging or local only;
# create the accounts with supabase/scripts/create-e2e-users.sql.
# E2E_MEMBER_EMAIL=e2e-member@nusantara.test
# E2E_MEMBER_PASSWORD=
# E2E_REVIEWER_EMAIL=e2e-reviewer@nusantara.test
# E2E_REVIEWER_PASSWORD=

# Phase 2+ only, server-side only. NEVER prefix these with NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY=        # AI Workflow server module (writes drafts only)
# ELEVENLABS_API_KEY=         # TTS for chapter audio (FR-05)
